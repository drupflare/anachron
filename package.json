{
	"private": true,
	"name": "@drupflare/anachron",
	"version": "0.1.0",
	"type": "module",
	"description": "Tooling only. The published artifact is the composer package drupflare/anachron.",
	"scripts": {
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "php tests/lint.php",
		"lint:php": "./vendor/bin/phpcs",
		"lint:php:fix": "./vendor/bin/phpcbf",
		"analyze": "./vendor/bin/phpstan analyse --memory-limit=1G",
		"test": "bun run test:php && bun run test:scripts",
		"test:php": "./vendor/bin/phpunit",
		"test:scripts": "bun test scripts",
		"test:classes": "php tests/load-classes.php",
		"test:coverage": "php -d opcache.enable_cli=0 ./vendor/bin/phpunit --coverage-clover coverage/anachron.clover.xml --coverage-text",
		"boundary": "bun scripts/boundary-check.ts",
		"inventory": "bun scripts/inventory/inventory.ts",
		"import:retrofit": "bun scripts/import-retrofit.ts",
		"release:check": "bun scripts/release-check.ts"
	},
	"devDependencies": {
		"@prettier/plugin-php": "^0.26.0",
		"@prettier/plugin-xml": "^3.4.2",
		"@types/bun": "^1.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-sh": "^0.20.0",
		"typescript": "^5.9.0"
	},
	"lint-staged": {
		"*.{md,json,yml,php,ts}": "prettier --write",
		"*.{php,module,install,inc}": [
			"./vendor/bin/phpcs --",
			"php tests/lint.php"
		]
	}
}
