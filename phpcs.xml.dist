<?xml version="1.0" ?>
<ruleset name="anachron">
	<description>Drupal coding standards, with the house layout exclusions.</description>

	<file>src</file>
	<file>tests</file>
	<arg name="extensions" value="php,module,install,inc" />
	<arg value="sp" />
	<arg name="colors" />

	<!--
		The fixture modules are deliberately written the way Drupal 7 through 10 code was written
		(long arrays, no docblocks, hook_menu callbacks), so linting them would only report that
		they are old.
	-->
	<exclude-pattern>tests/fixtures/*</exclude-pattern>

	<!--
		The Drupal layer under src/Drupal is a copy of Retrofit. Its style is Matt Glaman's, and
		reformatting 600 violations across files that stay close to upstream makes every later
		diff against it unreadable. Files written for this repository stay checked: src/Php,
		Switches.php, Extension/, legacy-classes.php and the ranked and legacy-removed function
		files.
	-->
	<exclude-pattern>src/Drupal/Access/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Asset/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Controller/*</exclude-pattern>
	<exclude-pattern>src/Drupal/DependencyInjection/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Entity/*</exclude-pattern>
	<exclude-pattern>src/Drupal/EventSubscriber/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Extension/ExtensionWrapper.php</exclude-pattern>
	<exclude-pattern>src/Drupal/Field/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Form/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Language/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Menu/*</exclude-pattern>
	<exclude-pattern>src/Drupal/ParamConverter/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Path/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Plugin/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Render/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Routing/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Template/*</exclude-pattern>
	<exclude-pattern>src/Drupal/Theme/*</exclude-pattern>
	<exclude-pattern>src/Drupal/User/*</exclude-pattern>
	<exclude-pattern>src/Drupal/constants/*</exclude-pattern>
	<exclude-pattern>src/Drupal/DB.php</exclude-pattern>
	<exclude-pattern>src/Drupal/Provider.php</exclude-pattern>
	<exclude-pattern>src/Drupal/bootstrap.php</exclude-pattern>
	<exclude-pattern>src/Drupal/constants.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/bootstrap.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/cache.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/common.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/db.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/field.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/file.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/form.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/lock.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/messages.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/module.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/namespaced.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/node.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/path.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/system.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/taxonomy.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/theme.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/user.php</exclude-pattern>
	<exclude-pattern>src/Drupal/functions/variable.php</exclude-pattern>

	<rule ref="Drupal">
		<!--
			The house rule is: import with `use`, then refer to the short name, everywhere, and
			the small global classes are not exempt. This sniff asserts the opposite.
		-->
		<exclude name="Drupal.Classes.UseGlobalClass.RedundantUseStatement" />
		<!--
			The project comment style for `//` comments is lowercase with no trailing period.
			Every Drupal.Commenting.DocComment.* sniff stays enabled: a docblock is real
			documentation and Drupal's capital-and-full-stop rule is correct there.
		-->
		<exclude name="Drupal.Commenting.InlineComment.NotCapital" />
		<exclude name="Drupal.Commenting.InlineComment.InvalidEndChar" />
		<exclude name="Drupal.Functions.DiscouragedFunctions.Discouraged" />
	</rule>

	<rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
		<properties>
			<property name="searchAnnotations" value="true" />
		</properties>
	</rule>

	<rule ref="DrupalPractice">
		<exclude name="DrupalPractice.Commenting.CommentEmptyLine.SpacingAfter" />
	</rule>

	<!--
		Drupal's default line limit is 80. The repository formats everything else at printWidth
		100 (.prettierrc), and two limits in one repository is incoherent.
	-->
	<rule ref="Drupal.Files.LineLength">
		<properties>
			<property name="lineLimit" value="110" />
		</properties>
	</rule>

	<!--
		Layout is not phpcs's job here. The house style is tabs rendered 4 wide at a 100-character
		line (.editorconfig, .prettierrc) and @prettier/plugin-php enforces it. The Drupal standard
		hard-codes two spaces and its own brace placement, so the two cannot both be right and
		phpcs loses that argument. Every entry below is whitespace, brace position or casing.
		phpcs keeps docs, naming, arrays, line length and every Drupal and DrupalPractice
		API-misuse check. Lowercase true, false and null match mantle2, the production Drupal
		module in this workspace.
	-->
	<rule ref="Drupal">
		<exclude name="Generic.PHP.UpperCaseConstant.Found" />
		<exclude name="Generic.WhiteSpace.DisallowTabIndent" />
		<exclude name="Generic.CodeAnalysis.UselessOverridingMethod.Found" />
		<exclude name="Drupal.WhiteSpace.ScopeIndent" />
		<exclude name="Drupal.WhiteSpace.ObjectOperatorIndent" />
		<exclude name="Drupal.WhiteSpace.ScopeClosingBrace" />
		<exclude name="Drupal.Arrays.Array.ArrayIndentation" />
		<exclude name="Drupal.Classes.ClassDeclaration.BraceOnNewLine" />
		<exclude name="Drupal.Classes.ClassDeclaration.CloseBraceAfterBody" />
		<exclude name="Drupal.Functions.MultiLineFunctionDeclaration.BraceOnNewLine" />
		<exclude name="Drupal.Functions.MultiLineFunctionDeclaration.Indent" />
		<exclude name="Drupal.ControlStructures.ControlSignature.NewlineAfterCloseBrace" />
		<exclude name="Drupal.Commenting.InlineComment.SpacingAfter" />
		<exclude name="Squiz.ControlStructures.ForEachLoopDeclaration.SpacingBeforeAs" />
		<exclude name="Squiz.WhiteSpace.FunctionSpacing.AfterLast" />
		<exclude name="Squiz.WhiteSpace.FunctionSpacing.BeforeFirst" />
	</rule>

	<!--
		src/Php/polyfills.php defines removed PHP functions under their original global names,
		which are snake_case and unprefixed by design: legacy callers use exactly these names.
	-->
	<rule ref="Drupal.NamingConventions.ValidFunctionName">
		<exclude-pattern>src/Php/polyfills.php</exclude-pattern>
	</rule>

	<rule ref="Drupal.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.DocComment.MissingShort">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.DocComment.ShortSingleLine">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.FunctionComment.MissingReturnComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.FunctionComment.MissingParamComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.FunctionComment.ParamMissingDefinition">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.NamingConventions.ValidFunctionName.ScopeNotCamelCaps">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="DrupalPractice.Variables.GetRequestData">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="DrupalPractice.Objects.StrictSchemaDisabled">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Classes.ClassFileName.NoMatch">
		<exclude-pattern>src/Drupal/legacy-classes.php</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.ClassComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Commenting.VariableComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Drupal.Classes.FullyQualifiedNamespace.UseStatementMissing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Classes.ClassFileName.NoMatch">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
