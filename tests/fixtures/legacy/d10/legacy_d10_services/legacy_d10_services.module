<?php

/**
 * @file
 * Hooks for the Legacy D10 services module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function legacy_d10_services_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.legacy_d10_services') {
    return '<p>' . t('Service and plugin code from the Drupal 10 API.') . '</p>';
  }
}
